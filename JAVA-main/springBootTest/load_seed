import re
import pymysql

SQL_PATH = "sql/init.sql"

# 读取 UTF-8 源码
with open(SQL_PATH, encoding="utf-8") as f:
    raw = f.read()

# 去掉行注释（-- 开头）与块注释（/* */），避免执行空/注释语句
lines = []
for line in raw.splitlines():
    if line.strip().startswith("--"):
        continue
    lines.append(line)
clean = "\n".join(lines)
clean = re.sub(r"/\*.*?\*/", "", clean, flags=re.DOTALL)

# 按语句分隔符拆分
stmts = [s.strip() for s in clean.split(";") if s.strip()]

conn = pymysql.connect(
    host="127.0.0.1", port=3306, user="root", password="123456",
    charset="utf8mb4", autocommit=True,
)
cur = conn.cursor()
ok = 0
for st in stmts:
    cur.execute(st)
    ok += 1
cur.close()
conn.close()
print(f"OK: executed {ok} statements from {SQL_PATH}")

# 统计
conn = pymysql.connect(host="127.0.0.1", port=3306, user="root", password="123456", database="starshop", charset="utf8mb4")
cur = conn.cursor()
for tbl in ("category", "product", "user"):
    cur.execute(f"SELECT COUNT(*) FROM {tbl}")
    print(f"  {tbl}: {cur.fetchone()[0]}")
cur.close()
conn.close()
